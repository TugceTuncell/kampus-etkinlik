          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Yeni kayıt ve kimlik doğru\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.match(/^event-\\d+$/);",
              "  pm.expect(data.title).to.eql(\"Git Atölyesi\");",
              "  pm.expect(data.capacity).to.eql(30);",
              "  pm.expect(data.time).to.eql(\"14:00\");",
              "  pm.expect(data.location).to.eql(\"Bilgisayar Laboratuvarı 1\");",
              "  pm.expect(data.description).to.eql(\"Git ve GitHub ile ilk adımlar.\");",
              "});"
            ]
          }
        }
      ],
